# ─── Staging environment (api.test.hub.borderlessunn.xyz) ─────────────
# Copy to `.env` on the staging server and fill every value.
# Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

SECRET_KEY=
DEBUG=False

ALLOWED_HOSTS=api.test.hub.borderlessunn.xyz

# PostgreSQL (running locally on the VPS)
DATABASE_NAME=borderless_hub_test_db
DATABASE_USER=borderless_hub_test_user
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Third-party (use TEST keys here)
API_KEY=
PAYSTACK_SECRET_KEY=

# Seed admin (used once by `manage.py createadmin`)
CUSTOM_ADMIN_EMAIL=
CUSTOM_ADMIN_NAME=
CUSTOM_ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=https://test.hub.borderlessunn.xyz
CSRF_TRUSTED_ORIGINS=https://api.test.hub.borderlessunn.xyz,https://test.hub.borderlessunn.xyz
