# /etc/systemd/system/gunicorn-hub-staging.service
[Unit]
Description=Gunicorn (staging) for Borderless Hub API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=hub
Group=www-data
WorkingDirectory=/var/www/borderless-hub-app-backend-test
EnvironmentFile=/var/www/borderless-hub-app-backend-test/.env
ExecStart=/var/www/borderless-hub-app-backend-test/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8002 \
    --access-logfile - \
    --error-logfile - \
    hub_auth.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
