# /etc/systemd/system/gunicorn-hub-prod.service
[Unit]
Description=Gunicorn (production) for Borderless Hub API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=hub
Group=www-data
WorkingDirectory=/var/www/borderless-hub-app-backend-prod
EnvironmentFile=/var/www/borderless-hub-app-backend-prod/.env
ExecStart=/var/www/borderless-hub-app-backend-prod/venv/bin/gunicorn \
    --workers 1 \
    --bind 127.0.0.1:8001 \
    --access-logfile - \
    --error-logfile - \
    hub_auth.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
